NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL（为空则 API 回退内存仓储）
DATABASE_URL=postgresql+asyncpg://aios:aios@127.0.0.1:5432/ai_learning_os
REDIS_URL=redis://127.0.0.1:6379/0

# 隐私路由（runbook 3 节）：local / cloud / hybrid
MODEL_ROUTE=hybrid
VOICE_MODE=local  # compose 生产版经 AIOS_VOICE_MODE 插值注入（local/hybrid/cloud）
SEARCH_MODE=local
PRIVACY_STORE_AUDIO=false
PRIVACY_SEND_CONTEXT_TO_CLOUD=true

# 对象存储（MinIO/S3）
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=ai-learning-os
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# 实时语音（M4 接入）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider 选型记录；真实 key 只放本机 .env 或部署 secret，绝不入库
ASR_PROVIDER=
TTS_PROVIDER=
LLM_PROVIDER=
EMBEDDING_PROVIDER=
SEARCH_PROVIDER=
