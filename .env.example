NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 认证：AUTH_SECRET 留空 = 本地单用户模式；Web 实际使用 HttpOnly cookie。
# HTTPS 部署设置 AUTH_COOKIE_SECURE=true；compose 宿主变量为 AIOS_AUTH_COOKIE_SECURE。
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# PostgreSQL（为空则 API 回退内存仓储）
DATABASE_URL=postgresql+asyncpg://aios:aios@127.0.0.1:5432/ai_learning_os
REDIS_URL=redis://127.0.0.1:6379/0

# 隐私路由（runbook 3 节）：local / cloud / hybrid
MODEL_ROUTE=hybrid
VOICE_MODE=local  # compose 生产版经 AIOS_VOICE_MODE 插值注入（local/hybrid/cloud）
SEARCH_MODE=local
PRIVACY_STORE_AUDIO=false
PRIVACY_SEND_CONTEXT_TO_CLOUD=true

# 对象存储（MinIO/S3）
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=ai-learning-os
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# 实时语音（M4 接入）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# M9-08 局域网/公开语音部署：LiveKit 浏览器可达地址与媒体通告（见 docs/DEVELOPMENT.md）
# PUBLIC_LIVEKIT_URL：token 返回给浏览器的 ws 地址（如 ws://<LAN_IP>:7880）——
#   公开绑定（AIOS_BIND_IP 非 loopback）时必配且不得是容器内部/127.0.0.1 地址（fail-closed）
PUBLIC_LIVEKIT_URL=
# compose 插值变量（AIOS_ 前缀）：
#   AIOS_LIVEKIT_EXTERNAL_IP=<LAN_IP>          → livekit --node-ip（局域网媒体面通告）
#   AIOS_LIVEKIT_CONFIG=/etc/livekit/livekit-public.yaml → 公网自动探测（use_external_ip=true）
# 防火墙放行：TCP 7880(signal)/7881(rtc-tcp) + UDP 7882-7892(媒体)

# M14-37 LiveKit 媒体面独立绑定（AIOS_LIVEKIT_BIND_IP，见 docs/DEVELOPMENT.md）：
#   用途：默认浏览器（无 Chromium loopback 受控 flag）连本机 loopback LiveKit
#   存在间歇性 ICE 失败（M14-35）——把 LiveKit 单独绑到本机 LAN IP 后，浏览器
#   拿到的是常规 LAN candidate，无需受控 flag；API/Web 仍走 AIOS_BIND_IP，
#   不必为此整体公开。
#   回落链：AIOS_LIVEKIT_BIND_IP → AIOS_BIND_IP → 127.0.0.1（默认零变化）；
#   --node-ip 回落链：AIOS_LIVEKIT_EXTERNAL_IP（显式优先）→ AIOS_LIVEKIT_BIND_IP
#   → 127.0.0.1。
#   安全边界（fail-closed）：设为非 loopback 时 API 启动要求
#     1) 强 AIOS_LIVEKIT_API_SECRET（≥32 字节且非公开默认占位值）；
#     2) AIOS_PUBLIC_LIVEKIT_URL=ws://<本机LAN_IP>:7880（浏览器可达，不得缺/loopback）。
#   API/Web 保持 loopback 时无需 APP_ENV=production / AIOS_CORS_ORIGINS 覆盖
#   （同机 localhost Web 源是合法场景）；务必填具体本机 IP，不要 0.0.0.0
#   （node-ip 通告 0.0.0.0 不可配对，等于没修）。
AIOS_LIVEKIT_BIND_IP=

# Provider 选型记录；真实 key 只放本机 .env 或部署 secret，绝不入库
ASR_PROVIDER=
TTS_PROVIDER=
LLM_PROVIDER=
# M14-01 本地真实语音引擎槽位（OpenAI 兼容本机服务，仅绑 127.0.0.1）：
#   部署见 tools/voice/README.md（WSL bootstrap 脚本 + 冒烟 + compose 接线）；
#   endpoint 留空 = local/hybrid 的 ASR 与 local 的 TTS 降级 fake/tone 替身
#   并在 providers 视图与响应头透出 fallback（不虚报已接真实引擎）；
#   key 可选（本地服务默认无鉴权）。
#   compose 形态经 AIOS_ASR_LOCAL_ENDPOINT / AIOS_TTS_LOCAL_ENDPOINT 插值注入
#   （容器内地址用 http://host.docker.internal:8010/v1，引擎仍只绑 WSL loopback）。
ASR_LOCAL_ENDPOINT=
ASR_LOCAL_MODEL=sensevoice
ASR_LOCAL_API_KEY=
TTS_LOCAL_ENDPOINT=
TTS_LOCAL_MODEL=Fun-CosyVoice3-0.5B-2512
TTS_LOCAL_API_KEY=
# M10-01 LLM 槽位（OpenAI 兼容端点；rubric_judge=llm 时启用模型判分）
# key 只放本机 .env 或部署 secret；三项任一缺席 = essay 全部进复核（fail-closed）
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
# 启用模型判分：RUBRIC_JUDGE=llm（默认 keyword=内置确定性判分）
RUBRIC_JUDGE=keyword
EMBEDDING_PROVIDER=
SEARCH_PROVIDER=

# HarmonyOS AGC 发布签名材料（M13-16a）：值只放本机/CI secret，绝不入库。
# 变量名与扩展名由 tools/harmony_release/preflight.py 约定（.cer / .p7b / .p12），
# 材料文件必须位于仓库之外；留空 = 材料未就位（preflight 默认模式即
# blocked_by_external_materials）。三个变量全部就位且有效后，签名期望模式
# `preflight --expect-signed` 才判 ok。
AIOS_HARMONY_CERT_PATH=
AIOS_HARMONY_PROFILE_PATH=
AIOS_HARMONY_KEYSTORE_PATH=
