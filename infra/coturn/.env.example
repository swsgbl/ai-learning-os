# M10-05 外部 coturn（TURN/STUN）部署变量示例。
# 用法：复制为本目录 .env（compose -f infra/coturn/docker-compose.coturn.yml 自动读取；
# .gitignore 已忽略 .env），填入部署值后启动：
#   docker compose -f infra/coturn/docker-compose.coturn.yml up -d
# 完整部署/防火墙/与 LiveKit 生产联动/验证说明：docs/COTURN_DEPLOYMENT.md

# ---- 必填（缺失时 docker compose config/up 直接失败——fail-closed，无默认值兜底） ----
# 与 LiveKit turn.secret 共用同一 secret（TURN REST 凭据 HMAC 同源校验）。
# openssl rand -hex 32 生成；只放本文件（.env，不入库）或部署 secret 管理，绝不提交仓库。
COTURN_STATIC_AUTH_SECRET=<openssl rand -hex 32 的输出>

# 宿主对外可达 IP（公网或局域网）。禁止 127.0.0.1（仅本机监听冒烟可经
# COTURN_ALLOW_LOOPBACK_EXTERNAL=true 显式豁免）。1:1 NAT 场景可用 PUBLIC/PRIVATE 形式。
COTURN_EXTERNAL_IP=<宿主公网/局域网 IP>

# ---- 可选（下列即默认值） ----
# 宿主端口绑定：TURN 面向外部客户端默认全网卡；只允许本机访问可改 127.0.0.1
COTURN_BIND_IP=0.0.0.0
# STUN/TURN listening 端口（UDP+TCP 都要放行）
COTURN_LISTEN_PORT=3478
# TLS listening 端口（TCP）。仅 COTURN_TLS_ENABLED=true 时 coturn 才真正监听
COTURN_TLS_PORT=5349
# relay 端口段（UDP+TCP）：默认 50000-50099，必须与主栈 LiveKit 媒体面 UDP 7882-7892
# 错开（entrypoint 硬检查；跨机部署豁免见下）
COTURN_RELAY_PORT_START=50000
COTURN_RELAY_PORT_END=50099
# 认证 realm（任意标识串；与 LiveKit 联动不要求一致）
COTURN_REALM=ai-learning-os
# TLS 默认关闭。启用需真实证书：取消 compose 里 tls 卷挂载注释、放证书到 ./tls/，
# 再置 true——entrypoint 校验文件真实存在，不做假 TLS 声明
COTURN_TLS_ENABLED=false
# 证书挂载进容器后的路径（与 compose 卷挂载目标 /etc/coturn/tls 一致）
COTURN_CERT_FILE=/etc/coturn/tls/cert.pem
COTURN_PKEY_FILE=/etc/coturn/tls/key.pem
# 排障时置 true（coturn verbose 详细日志输出到 stdout）
COTURN_VERBOSE=false
# 仅本机监听冒烟豁免 loopback external-ip 检查——生产必须为 false
COTURN_ALLOW_LOOPBACK_EXTERNAL=false
# 跨机部署（coturn 与 LiveKit 不同宿主）时豁免 7882-7892 重叠检查
COTURN_ALLOW_LIVEKIT_PORT_OVERLAP=false
# 镜像：生产建议 pin 具体版本（如 coturn/coturn:4.6.2）保证可重现
COTURN_IMAGE=coturn/coturn:latest
