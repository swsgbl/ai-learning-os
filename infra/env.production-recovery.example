# M14-06 生产恢复编排环境模板（生产彩排栈 pin 事实源）
# ------------------------------------------------------------------
# 用法：复制为 infra/env.production-recovery（同目录，去掉 .example），
# 填入部署当时的真实值。真实文件已被 .gitignore 忽略（infra/env.production-recovery），
# 任何情况下不得提交、不得回显其值到日志/输出。
#
# 恢复编排（tools/ops/production_recovery.py）enforce 模式把本文件经
# docker compose --env-file 传入，并以「键名集合 + 与在线容器的一致性」做
# 前置校验（pin check）：文件缺失、必需键缺失、含本模板占位值（<...> 包裹
# 或模板原文——照抄未填即拒）、在线容器事实缺失、或值与在线容器不一致
# （仅报键名，绝不报值）都会在 up 之前可见拒绝——防止恢复路径用默认值/
# 漂移值/占位值静默重建容器（镜像 tag、端口、密钥轮换）。
#
# 必需键（PIN_KEYS，缺失即拒绝）：
#   AIOS_IMAGE_TAG          发布镜像 tag（与 aios/api、aios/web 在线镜像一致）
#   AIOS_APP_ENV            API 环境（生产彩排栈为 production）
#   AIOS_WEB_PORT           Web 宿主端口（生产彩演栈为 3011）
#   AIOS_AUTH_SECRET        认证 secret（部署时生成；绝不入库/入日志）
#   AIOS_LIVEKIT_API_SECRET LiveKit 凭据（与 api 容器一致；绝不入库/入日志）
# ------------------------------------------------------------------

AIOS_IMAGE_TAG=m14-03-prod-rehearsal
AIOS_APP_ENV=production
AIOS_WEB_PORT=3011
AIOS_AUTH_SECRET=<部署时生成的真实值——绝不提交>
AIOS_LIVEKIT_API_SECRET=<部署时生成的真实值——绝不提交>
