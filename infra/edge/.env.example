# M14-153 VPS 边缘栈部署 env 模板（example）。
#
# 用法：cp .env.example .env && chmod 600 .env，填真实值后供
# docker compose -f docker-compose.edge.example.yml 使用。.env 已被
# .gitignore 忽略，绝不提交。所有 <...> 均为占位——仓库不含任何真实
# 域名/IP/证书/token/密码。

# VPS 公网 IPv4（LiveKit candidate 通告 + coturn external-ip）
AIOS_EDGE_VPS_PUBLIC_IP=<VPS 公网 IPv4>

# LiveKit API 凭据（部署密钥文件，官方 --key-file 路径）：
# 文件内容一行 "<api-key>: <api-secret>"，与家用 Windows 生产 env 的
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET 同值（家机 API 签 token，VPS 验 token）。
# secret 长度不低于 32 字符，不得使用仓库开发占位 secret。LiveKit 强制
# key 文件 0600（可被 other 读即拒绝启动）：
#   install -m 600 /dev/null /opt/aios-edge/secrets/livekit_keys
#   printf '%s: %s\n' "<api-key>" "<api-secret>" > /opt/aios-edge/secrets/livekit_keys
AIOS_EDGE_LIVEKIT_KEYS_FILE=/opt/aios-edge/secrets/livekit_keys

# ---------------------------------------------------------------- TURN secret
# 同源双槽位部署清单（LiveKit 与 coturn 必须读同一个值，缺一不可）：
#
#   [ ] 1. 生成一次且只生成一次：
#        openssl rand -hex 32 | tee /opt/aios-edge/secrets/turn.secret
#        chmod 600 /opt/aios-edge/secrets/turn.secret
#   [ ] 2. AIOS_EDGE_TURN_SECRET_FILE 指向该文件 —— LiveKit 经
#        rtc.turn_servers[].secret_file 读取（livekit.edge.yaml）
#   [ ] 3. AIOS_EDGE_COTURN_TURN_SECRET 填入同一个值 —— coturn 经
#        COTURN_STATIC_AUTH_SECRET env 读取（entrypoint 校验长度>=32）
#   [ ] 4. 落地自检（两者不同值 = LiveKit 派发的 TURN 凭据被 coturn 401，
#        公网语音静默失败，必须在此拦下）：
#        test "$(cat /opt/aios-edge/secrets/turn.secret)" = "$AIOS_EDGE_COTURN_TURN_SECRET"
#   [ ] 5. 端到端复验（部署后）：tools/ops/public_edge_preflight.py
#        的 TURN/TLS 探测 + 手机 4G/5G trickle-ice relay 验收
AIOS_EDGE_COTURN_TURN_SECRET=<openssl rand -hex 32 的输出，与 turn.secret 文件同值>
AIOS_EDGE_TURN_SECRET_FILE=/opt/aios-edge/secrets/turn.secret

# frps token：文件与家机 frpc_token.txt 同值（生成方式同上，单值文件、600 权限）
AIOS_EDGE_FRPS_TOKEN_FILE=/opt/aios-edge/secrets/frps_token.txt

# TURN/TLS（Phase 4）：./turn-tls/ 放好 turn.<真实域名> 证书（DNS-01 签发，
# 见 runbook 第 6 节）后置 true；置 false 期间不宣称公网语音生产可用
AIOS_EDGE_COTURN_TLS_ENABLED=false
